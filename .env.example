# Reference values only. n8n does not read this file automatically — these
# placeholders describe the values you will enter into n8n credentials and
# node parameters after importing the workflows. NEVER put real secrets in
# this file or commit a real .env alongside it.

# Telegram bot token, from @BotFather (used by the Get Telegram Updates
# HTTP Request node's URL, and by the Telegram API credential)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Your personal Telegram numeric chat/user ID (message @userinfobot to find it)
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Base URL of your running Ollama instance
# (host.docker.internal:11434 for Docker n8n talking to host-machine Ollama,
#  localhost:11434 for a native install)
OLLAMA_URL=YOUR_OLLAMA_URL

# URL of your self-hosted ChromaDB instance
# (host.docker.internal:8000 for Docker n8n talking to host-machine ChromaDB,
#  localhost:8000 for a native install)
CHROMADB_URL=YOUR_CHROMADB_URL
